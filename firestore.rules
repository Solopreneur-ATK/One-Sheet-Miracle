rules_version = '2';

// Firestore Security Rules for the Study Portal (Google Sign-In + manual
// approval). Paste this into Firebase Console → Firestore Database →
// Rules, replacing whatever is there, then click "Publish".
//
// What this enforces (the "hard gate" — checked on Google's servers,
// not just hidden by front-end JavaScript, so it can't be bypassed by
// viewing source or editing the page):
//   - A signed-in user can read ONLY their own document.
//   - A signed-in user can CREATE their own document the first time they
//     sign in, but every course in it must start as "pending" — they
//     cannot create themselves as "approved".
//   - Nobody can UPDATE a document from the app. The only way a course
//     flips from "pending" to "approved" is you editing it by hand in
//     the Firebase Console (Firestore Database → users → the person's
//     document → edit the field). That is the approval step described
//     as "ผมจะเป็นคนกดอนุญาตสิทธิ์เอง".
//   - Nobody can delete a document from the app.

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.courses.values().hasOnly(['pending']);

      allow update: if false;
      allow delete: if false;
    }
  }
}
